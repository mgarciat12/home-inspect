# Copy to .env and fill in. Docker Compose reads it automatically. NEVER commit .env.
# Generate secrets with:  openssl rand -base64 32

# ---- PostgreSQL (your existing server) ----
# Postgres on the Docker host: host.docker.internal. In another container: its name (see docker-compose.dbnet.yml)
DB_HOST=host.docker.internal
DB_PORT=5432
# Network of your Postgres container (only with docker-compose.dbnet.yml)
#DB_NETWORK=postgres_default
#COMPOSE_FILE=docker-compose.yml:docker-compose.dbnet.yml

AUTH_DB_NAME=homeinspect_auth
AUTH_DB_USER=homeinspect_auth
AUTH_DB_PASSWORD=change-me

APP_DB_NAME=homeinspect_app
APP_DB_USER=homeinspect_app
APP_DB_PASSWORD=change-me

# ---- Public URLs ----
# Issuer of the authorization server. Browser AND the app container must reach it at this exact URL.
AUTH_ISSUER_URI=https://auth.example.home
# Public URL of the application (used for the OAuth2 redirect and the post-logout redirect)
APP_BASE_URL=https://inspect.example.home

# Host ports
AUTH_PORT=9000
APP_PORT=8080

# ---- Authorization server ----
# Administrator created on first start (must change the password at first login)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me-now
# Password of the PKCS12 keystore holding the JWT signing key (volume auth-keys)
AUTH_KEYSTORE_PASSWORD=change-me
# Secrets of the two OAuth2 clients (the app uses both)
WEB_CLIENT_SECRET=change-me
ADMIN_API_CLIENT_SECRET=change-me

# Two-step verification with an authenticator app (TOTP).
#  AUTH_MFA_ENABLED=true  -> each user can activate it (on the access server page)
#  AUTH_MFA_REQUIRED=true -> every user must set it up at next login
AUTH_MFA_ENABLED=false
AUTH_MFA_REQUIRED=false

# ---- Application ----
# Max size of each photo
UPLOAD_MAX_FILE_SIZE=15MB
# Spring profiles, e.g. "demo" to load the sample report
APP_PROFILES=

# Secure cookies: true behind an HTTPS reverse proxy, false for plain-HTTP local tests
COOKIE_SECURE=true
TZ=Europe/Madrid
